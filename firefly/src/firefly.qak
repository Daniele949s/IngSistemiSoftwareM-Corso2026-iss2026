System firefly

Dispatch cellstate : cellstate(X,Y,COLOR)
Dispatch sync_on   : sync_on(S)
Dispatch sync_off  : sync_off(S)
Event    data      : distance(D)

Context ctxfirefly ip [ host="localhost"      port=8040 ] 
Context ctxgrid    ip [ host="127.0.0.1"      port=8050 ]

ExternalQActor griddisplay context ctxgrid

QActor sonar context ctxfirefly {
	[# var Distance = 1 #] 
	State s0 initial { }
	Goto sonar_on
	
	State sonar_on {
		[# Distance = java.util.Random().nextInt(1, 30) #]
		emit data : distance($Distance)
		delay 2000 
	}
	Goto sonar_on
}

QActor sync_actor context ctxfirefly {
	[# var DMIN = 10 #]
	State s0 initial { }
	Goto wait_events
	
	State wait_events {
		onMsg(data : distance(D)) {
			[# 
			   var Dist = payloadArg(0).toInt() 
			   var Obstacle = (Dist < DMIN)
			#]
			
			if [# Obstacle #] {
				forward firefly1 -m sync_on : sync_on(S)
				forward firefly2 -m sync_on : sync_on(S)
				forward firefly3 -m sync_on : sync_on(S)
				forward firefly4 -m sync_on : sync_on(S)
				forward firefly5 -m sync_on : sync_on(S)
				forward firefly6 -m sync_on : sync_on(S)
				
			}
			if [# !Obstacle #] {
				forward firefly1 -m sync_off : sync_off(S)
				forward firefly2 -m sync_off : sync_off(S)
				forward firefly3 -m sync_off : sync_off(S)
				forward firefly4 -m sync_off : sync_off(S)
				forward firefly5 -m sync_off : sync_off(S)
				forward firefly6 -m sync_off : sync_off(S)
			}
		}
	}
	Transition t1
		whenEvent data -> wait_events
}

QActor firefly1 context ctxfirefly {     
	[# var X = 10; var Y = 10; var Sync = false; var T = 1000L #] 
	State s0 initial { }
	Goto flash
	
	State flash {
	    onMsg( sync_on : sync_on(S) ) {
	        [# Sync = true #]
	    }
	    onMsg( sync_off : sync_off(S) ) {
	        [# Sync = false #]
	    }
	
		forward griddisplay -m cellstate : cellstate($X,$Y,1) 				
 		delay 500	
 		forward griddisplay -m cellstate : cellstate($X,$Y,0)
 		
 		[# 
 		   if(Sync) { T = 500L } 
 		   else { T = java.util.Random().nextLong(1000L, 2000L) } 
 		#]
	}
	Transition t0 
	    whenTimeVar T -> flash
	    whenMsg sync_on -> flash
	    whenMsg sync_off -> flash
}

